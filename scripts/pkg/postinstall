#!/bin/bash
# runs as root after the payload is in place: let coreaudiod pick up the
# driver and start the daemon as a LaunchAgent of the logged-in user

# SIP forbids kickstarting apple daemons - killall works, launchd restarts it
killall coreaudiod 2>/dev/null
sleep 2

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
    echo "no user logged in - start Ponte from /Applications after login"
    exit 0
fi
CONSOLE_UID="$(id -u "$CONSOLE_USER")"
CONSOLE_HOME="$(dscl . -read "/Users/${CONSOLE_USER}" NFSHomeDirectory | sed 's/^NFSHomeDirectory: //')"
PLIST="${CONSOLE_HOME}/Library/LaunchAgents/io.github.ytb1124.ponte.daemon.plist"

sudo -u "$CONSOLE_USER" mkdir -p "${CONSOLE_HOME}/Library/LaunchAgents" \
     "${CONSOLE_HOME}/Library/Logs/Ponte" \
     "${CONSOLE_HOME}/Library/Application Support/Ponte"
sed "s|__HOME__|${CONSOLE_HOME}|g" /usr/local/share/ponte/io.github.ytb1124.ponte.daemon.plist > "$PLIST"
chown "$CONSOLE_USER" "$PLIST"
chmod 644 "$PLIST"

launchctl bootout "gui/${CONSOLE_UID}/io.github.ytb1124.ponte.daemon" 2>/dev/null
# a disabled agent (for example switched off under Login Items) is never
# loaded at login and bootstrap fails with error 5; installing means the
# user wants it running, so clear that flag first
launchctl enable "gui/${CONSOLE_UID}/io.github.ytb1124.ponte.daemon"
if ! launchctl bootstrap "gui/${CONSOLE_UID}" "$PLIST"; then
    echo "could not start the Ponte agent - check System Settings > General > Login Items"
fi
exit 0
