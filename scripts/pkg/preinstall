#!/bin/bash
# runs as root before the payload is copied: stop a running daemon so its
# binary can be replaced, and clear leftovers of older installs

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    CONSOLE_UID="$(id -u "$CONSOLE_USER")"
    launchctl bootout "gui/${CONSOLE_UID}/io.github.ytb1124.ponte.daemon" 2>/dev/null
    for _ in $(seq 1 15); do pgrep -f ponte-daemon >/dev/null || break; sleep 1; done
fi

rm -rf /Applications/Ponte.app /Library/Audio/Plug-Ins/HAL/Ponte.driver
rm -rf /usr/local/share/ponte/webui
exit 0
